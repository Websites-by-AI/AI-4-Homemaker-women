# اتصال دیتابیس PostgreSQL (در Neon رایگان بساز: neon.tech)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# رمز امضای توکن ورود/ثبت‌نام — یک رشتهٔ تصادفی طولانی بگذار
JWT_SECRET="change-me-to-a-long-random-secret"

# ── مربی هوشمند RAG (OpenRouter) ──
# کلید رایگان از openrouter.ai/keys بگیر و اینجا/در Vercel بگذار
OPENROUTER_API_KEY="sk-or-..."
# مدل چت (پیش‌فرض: google/gemini-2.0-flash-001 — فلش ارزان و سریع)
OPENROUTER_CHAT_MODEL="google/gemini-2.0-flash-001"
# مدل امبدینگ برای جستجوی معنایی RAG
OPENROUTER_EMBED_MODEL="openai/text-embedding-3-small"
